@model MVC.Areas.Auth.Models.Forms.ChangePasswordForm
@{
    ViewData["Title"] = "Change password";
}

<section class="editor-heading">
    <a class="back-link" asp-area="Auth" asp-controller="Profile" asp-action="Index">← Back to account settings</a>
    <p class="eyebrow">Access & security</p>
    <h1>Change password</h1>
    <p>Enter your current password, then choose a new one.</p>
</section>

<section class="auth-card password-card">
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
    <form method="post" asp-area="Auth" asp-controller="Profile" asp-action="ChangePassword">
        <label asp-for="OldPassword" class="auth-field">
            Current password
            <input asp-for="OldPassword" class="form-control" type="password" autocomplete="current-password" />
            <span asp-validation-for="OldPassword"></span>
        </label>
        <label asp-for="NewPassword" class="auth-field">
            New password
            <input asp-for="NewPassword" class="form-control" type="password" autocomplete="new-password" />
            <span asp-validation-for="NewPassword"></span>
            <small>Use at least 15 characters.</small>
        </label>
        <label asp-for="ConfirmPassword" class="auth-field">
            Confirm new password
            <input asp-for="ConfirmPassword" class="form-control" type="password" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword"></span>
        </label>
        <div class="auth-actions">
            <button type="submit" class="button button-search">Save password</button>
            <a asp-area="Auth" asp-controller="Profile" asp-action="Index" class="button button-quiet">Cancel</a>
        </div>
    </form>
</section>