@model MVC.Areas.Auth.Models.Forms.ProfileForm
@{
    ViewData["Title"] = "Edit account details";
}

<section class="editor-heading">
    <a class="back-link" asp-area="Auth" asp-controller="Profile" asp-action="Index">← Back to account settings</a>
    <p class="eyebrow">Your account</p>
    <h1>Edit account details</h1>
    <p>Update the name and phone number connected to your account.</p>
</section>

<div class="editor-layout">
    <form class="profile-editor" method="post" enctype="multipart/form-data" asp-area="Auth" asp-controller="Profile" asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <section class="editor-section">
            <p class="eyebrow">Contact details</p>
            <div class="editor-grid">
                <div class="form-field editor-wide">
                    <label asp-for="FullName">Full name</label>
                    <input asp-for="FullName" class="form-control" autocomplete="name" />
                    <span asp-validation-for="FullName"></span>
                </div>
                <div class="form-field editor-wide">
                    <label asp-for="Phone">Phone number <span class="optional-label">Optional</span></label>
                    <input asp-for="Phone" class="form-control" type="tel" autocomplete="tel" />
                    <span asp-validation-for="Phone"></span>
                </div>
                <div class="form-field editor-wide">
                    <label asp-for="Image">Profile photo <span class="optional-label">Optional</span></label>
                    <div class="file-picker">
                    <input asp-for="Image" class="file-picker-input" type="file" data-status-target="account-photo-status" aria-describedby="account-photo-help account-photo-status" accept=".jpg,.jpeg,.png,.gif" />
                    <label class="file-picker-button" for="Image">Choose a photo</label>
                    <span id="account-photo-status" class="file-picker-status">No file selected</span>
                </div>
                    <small id="account-photo-help">Upload a JPG, PNG, or GIF image.</small>
                    <span asp-validation-for="Image"></span>
                </div>
                @if (!string.IsNullOrEmpty(Model.ImagePath))
                {
                    <div class="form-field editor-wide">
                        <span>Current photo</span>
                        <img class="account-profile-image" src="@Model.ImagePath" alt="" />
                    </div>
                }
            </div>
        </section>
        <div class="editor-actions">
            <a class="button button-quiet" asp-area="Auth" asp-controller="Profile" asp-action="Index">Cancel</a>
            <button type="submit" class="button button-search">Save changes</button>
        </div>
    </form>

    <aside class="editor-aside">
        <span class="aside-label">Account details</span>
        <h2>Keep your contact information current.</h2>
        <p>Your account details help you manage your access. Your professional profile is edited separately.</p>
    </aside>
</div>