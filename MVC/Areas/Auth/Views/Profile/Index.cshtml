@model MVC.Models.User
@{
    ViewData["Title"] = "Account settings";
}

<section class="editor-heading">
    <a class="back-link" asp-area="" asp-controller="Home" asp-action="Index">← Back to directory</a>
    <p class="eyebrow">Your account</p>
    <h1>Account settings</h1>
    <p>Manage the details connected to your MVS Skills account.</p>
</section>

<div class="account-settings-grid">
    <section class="setting-panel" aria-labelledby="account-details-title">
        <p class="eyebrow">Account details</p>
        <h2 id="account-details-title">Your information</h2>
        @if (!string.IsNullOrEmpty(Model.ImagePath))
        {
            <img class="account-profile-image" src="@Model.ImagePath" alt="" />
        }
        <dl class="account-details-list">
            <div><dt>Name</dt><dd>@(string.IsNullOrWhiteSpace(Model.FullName) ? "Not added" : Model.FullName)</dd></div>
            <div><dt>Email</dt><dd>@Model.Email</dd></div>
            <div><dt>Phone</dt><dd>@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "Not added" : Model.PhoneNumber)</dd></div>
        </dl>
        <a asp-area="Auth" asp-controller="Profile" asp-action="Edit" class="button button-search">Edit account details</a>
    </section>

    <section class="setting-panel" aria-labelledby="account-security-title">
        <p class="eyebrow">Access & security</p>
        <h2 id="account-security-title">Account access</h2>
        <p>Change your password if you need to refresh the credentials for this account.</p>
        <div class="setting-actions">
            <a asp-area="Auth" asp-controller="Profile" asp-action="ChangePassword" class="button button-primary">Change password</a>
            <a asp-area="Auth" asp-controller="Profile" asp-action="DeleteAccount" class="text-action text-action-danger">Delete account</a>
        </div>
    </section>
</div>