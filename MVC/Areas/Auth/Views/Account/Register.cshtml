@using MVC.Areas.Auth.Models.Forms
@model RegisterForm
@{
    ViewData["Title"] = "Create account";
    var returnUrl = Context.Request.Query["ReturnUrl"];
    if (string.IsNullOrEmpty(returnUrl))
    {
        returnUrl = "/";
    }
}
<section class="auth-card">
    <p class="eyebrow">Join the directory</p>
    <h1>Create your account</h1>
    <p>Set up access, then add a professional profile.</p>
    <form method="post" asp-area="Auth" asp-controller="Account" asp-action="Register">
        <input type="hidden" name="ReturnUrl" value="@returnUrl" />
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
        <label asp-for="Login" class="auth-field">
            Email address
            <input asp-for="Login" class="form-control" type="email" autocomplete="username" />
            <span asp-validation-for="Login"></span>
        </label>
        <label asp-for="Password" class="auth-field">
            Password
            <input asp-for="Password" class="form-control" type="password" autocomplete="new-password" />
            <span asp-validation-for="Password"></span>
            <small>Use at least 15 characters.</small>
        </label>
        <div class="auth-actions">
            <button class="button button-search" type="submit">Create account <span aria-hidden="true">→</span></button>
            <a class="button button-quiet" asp-area="Auth" asp-controller="Account" asp-action="Login" asp-route-ReturnUrl="@returnUrl">Sign in</a>
        </div>
    </form>
</section>