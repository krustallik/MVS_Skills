@using MVC.Areas.Auth.Models.Forms
@model LoginForm
@{
    ViewData["Title"] = "Sign in";
    var returnUrl = Context.Request.Query["ReturnUrl"];
    if (string.IsNullOrEmpty(returnUrl))
    {
        returnUrl = "/";
    }
}
<section class="auth-card">
    <p class="eyebrow">Welcome back</p>
    <h1>Sign in</h1>
    <p>Continue to your profile and the people directory.</p>
    <form method="post" asp-area="Auth" asp-controller="Account" asp-action="Login">
        <input type="hidden" name="ReturnUrl" value="@returnUrl" />
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
        <label asp-for="Login" class="auth-field">
            Email address
            <input asp-for="Login" class="form-control" type="email" autocomplete="username" />
            <span asp-validation-for="Login"></span>
        </label>
        <label asp-for="Password" class="auth-field">
            Password
            <input asp-for="Password" class="form-control" type="password" autocomplete="current-password" />
            <span asp-validation-for="Password"></span>
        </label>
        <div class="auth-actions">
            <button class="button button-search" type="submit">Sign in <span aria-hidden="true">→</span></button>
            <a class="button button-quiet" asp-area="Auth" asp-controller="Account" asp-action="Register" asp-route-ReturnUrl="@returnUrl">Create account</a>
        </div>
    </form>
</section>