@model List<MVC.Models.UserSkill>
@{
    ViewData["Title"] = "Manage skills";
    var userId = (int)ViewBag.UserId;
}

<section class="editor-heading">
    <a class="back-link" asp-controller="UserInfo" asp-action="View" asp-route-id="@userId">← Back to profile</a>
    <p class="eyebrow">Profile management</p>
    <h1>Manage skills</h1>
    <p>Keep the expertise on this profile accurate, clear, and easy to scan.</p>
</section>

<div class="skill-manage-toolbar">
    <p><strong>Profile @userId</strong><span>@Model.Count @(Model.Count == 1 ? "skill" : "skills")</span></p>
    <a asp-action="Create" asp-route-userId="@userId" class="button button-search">Add a skill</a>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state skill-empty">
        <span class="empty-mark" aria-hidden="true">＋</span>
        <div>
            <p class="eyebrow">A clear place to start</p>
            <h2>No skills on this profile yet.</h2>
            <p>Add a skill and choose a level to help people understand this professional's strengths.</p>
        </div>
    </div>
}
else
{
    <div class="skill-list-editor" aria-label="Skills on profile">
        @foreach (var userSkill in Model)
        {
            var skillInitial = string.IsNullOrWhiteSpace(userSkill.Skill.Title) ? "S" : userSkill.Skill.Title[..1].ToUpperInvariant();
            <article class="managed-skill-row">
                <span class="managed-skill-mark" aria-hidden="true">@skillInitial</span>
                <div class="managed-skill-copy">
                    <h2>@userSkill.Skill.Title</h2>
                    <p>Level @userSkill.Level</p>
                </div>
                <div class="managed-skill-meter" role="meter" aria-label="@userSkill.Skill.Title proficiency" aria-valuemin="1" aria-valuemax="100" aria-valuenow="@userSkill.Level">
                    <span>Proficiency</span>
                    <div class="skill-meter-track" aria-hidden="true"><span style="width: @Math.Clamp(userSkill.Level, 1, 100)%"></span></div>
                </div>
                <div class="managed-skill-actions">
                    <a class="text-action" asp-action="Edit" asp-route-id="@userSkill.SkillId" asp-route-userId="@userId">Edit</a>
                    <a class="text-action text-action-danger" asp-action="Delete" asp-route-skillId="@userSkill.SkillId" asp-route-userId="@userId">Remove</a>
                </div>
            </article>
        }
    </div>
}