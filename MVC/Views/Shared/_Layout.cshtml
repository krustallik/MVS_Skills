@using Microsoft.AspNetCore.Identity
@using MVC.Models
@inject UserManager<User> UserManager
@inject SignInManager<User> SignInManager
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}
<!DOCTYPE html>
<html lang="en-US">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · MVS Skills</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MVC.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="site-nav" aria-label="Main navigation">
            <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="brand-mark" aria-hidden="true">M</span>
                <span>MVS <strong>Skills</strong></span>
            </a>
            <div class="nav-links">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="@(currentController == "Home" ? "nav-current" : null)" aria-current="@(currentController == "Home" ? "page" : null)">Explore people</a>
                @if (SignInManager.IsSignedIn(User))
                {
                    <a asp-area="" asp-controller="UserInfo" asp-action="Index" class="@(currentController == "UserInfo" && currentAction == "Index" ? "nav-current" : null)" aria-current="@(currentController == "UserInfo" && currentAction == "Index" ? "page" : null)">My profiles</a>
                }
            </div>
            <div class="nav-account">
                @if (SignInManager.IsSignedIn(User))
                {
                    var currentUser = await UserManager.GetUserAsync(User);
                    var accountLabel = currentUser?.Email?.Split('@')[0] ?? "Account";
                    <details class="account-menu">
                        <summary><span class="account-avatar" aria-hidden="true">@accountLabel[..1].ToUpperInvariant()</span><span>@accountLabel</span></summary>
                        <div class="account-dropdown">
                            <a asp-area="Auth" asp-controller="Profile" asp-action="Index">Profile settings</a>
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-area="Auth" asp-controller="Admin" asp-action="Index">Admin panel</a>
                            }
                            <form method="post" asp-area="Auth" asp-controller="Account" asp-action="Logout">
                                <button type="submit">Sign out</button>
                            </form>
                        </div>
                    </details>
                }
                else
                {
                    <a class="nav-login" asp-area="Auth" asp-controller="Account" asp-action="Login">Sign in</a>
                    <a class="button button-nav" asp-area="Auth" asp-controller="Account" asp-action="Register">Create account</a>
                }
            </div>
        </nav>
    </header>
    <main class="page-shell">
        @if (TempData["AccountNotice"] is string accountNotice)
        {
            <div class="account-notice" role="status">@accountNotice</div>
        }
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div><span class="brand-mark brand-mark-small" aria-hidden="true">M</span> MVS Skills</div>
        <p>A focused directory for skills, experience, and people.</p>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>