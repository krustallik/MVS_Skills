@using System.Globalization
@model IReadOnlyList<MVC.Models.SearchProfileViewModel>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <span class="empty-mark" aria-hidden="true">◎</span>
        <div>
            <p class="eyebrow">No matches yet</p>
            <h3>No profiles match those filters.</h3>
            <p>Try a broader search or add a profile to the directory.</p>
        </div>
    </div>
}
else
{
    @foreach (var profile in Model)
    {
        var initials = string.Concat(profile.Name
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(part => char.ToUpperInvariant(part[0])));

        <article class="profile-card">
            <div class="profile-card-top">
                <div class="profile-avatar" aria-hidden="true">@initials</div>
                @if (profile.RatingCount > 0)
                {
                    <span class="profile-rating" aria-label="@profile.AverageRating?.ToString("0.0", CultureInfo.InvariantCulture) out of 5 from @profile.RatingCount ratings">
                        <span aria-hidden="true">★</span> @profile.AverageRating?.ToString("0.0", CultureInfo.InvariantCulture)
                        <span class="rating-count">(@profile.RatingCount)</span>
                    </span>
                }
                else
                {
                    <span class="profile-rating profile-rating-new">New profile</span>
                }
            </div>
            <h3>@profile.Name</h3>
            <p class="profile-role">@(string.IsNullOrWhiteSpace(profile.Profession) ? "Professional" : profile.Profession)</p>
            <p class="profile-experience">@profile.ExperienceYears years of experience</p>
            <div class="skill-list" aria-label="Skills">
                @foreach (var skill in profile.Skills)
                {
                    <span class="skill-pill">@skill</span>
                }
                @if (profile.SkillCount > profile.Skills.Count)
                {
                    <span class="skill-pill skill-pill-more">+@(profile.SkillCount - profile.Skills.Count)</span>
                }
            </div>
            <a class="profile-link" asp-controller="UserInfo" asp-action="View" asp-route-id="@profile.Id">View profile <span aria-hidden="true">↗</span></a>
        </article>
    }
}