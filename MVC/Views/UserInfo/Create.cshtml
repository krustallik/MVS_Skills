@using System.Globalization
@model MVC.Models.Forms.UserInfoForm
@{
    ViewData["Title"] = "Create a profile";
    var i = 0;
    var list = new SelectList(Model.Professions.Select(x => new { Id = i++, Title = x }).ToList(), "Id", "Title");
    var birthdayValue = Model.Birthday == default ? string.Empty : Model.Birthday.ToString("MM/dd/yyyy", CultureInfo.InvariantCulture);
}

<section class="editor-heading">
    <a class="back-link" asp-controller="Home" asp-action="Index">← Back to directory</a>
    <p class="eyebrow">Your profile</p>
    <h1>Create a profile</h1>
    <p>Share the professional details that help people understand your work and find your skills.</p>
</section>

<div class="editor-layout">
    <form class="profile-editor" method="post" enctype="multipart/form-data" asp-controller="UserInfo" asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <div class="editor-section">
            <p class="eyebrow">About you</p>
            <div class="editor-grid">
                <div class="form-field">
                    <label asp-for="Name">Name</label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Mira Novak" autocomplete="name" />
                    <span asp-validation-for="Name"></span>
                </div>
                <div class="form-field">
                    <label asp-for="ProfessionId">Profession</label>
                    @Html.DropDownListFor(x => x.ProfessionId, list, "Choose a profession", new { @class = "form-select" })
                    <span asp-validation-for="ProfessionId"></span>
                </div>
                <div class="form-field editor-wide">
                    <label asp-for="Description">About your work</label>
                    <textarea asp-for="Description" class="form-control" rows="5" placeholder="Describe your focus, strengths, and the work you enjoy."></textarea>
                    <span asp-validation-for="Description"></span>
                </div>
            </div>
        </div>

        <div class="editor-section">
            <p class="eyebrow">Experience & contact</p>
            <div class="editor-grid">
                <div class="form-field">
                    <label asp-for="ExpirienseYears">Years of experience</label>
                    <input asp-for="ExpirienseYears" class="form-control" type="number" min="0" max="99" step="1" />
                    <span asp-validation-for="ExpirienseYears"></span>
                </div>
                <div class="form-field">
                    <label asp-for="Salary">Expected salary</label>
                    <input asp-for="Salary" class="form-control" type="text" lang="en-US" inputmode="decimal" autocomplete="off" />
                    <small>Use a decimal point, for example 1250.00.</small>
                    <span asp-validation-for="Salary"></span>
                </div>
                <div class="form-field">
                    <label asp-for="Email">Contact email</label>
                    <input asp-for="Email" class="form-control" type="email" placeholder="you@example.com" autocomplete="email" />
                    <span asp-validation-for="Email"></span>
                </div>
                <div class="form-field">
                    <label asp-for="Birthday">Date of birth</label>
                    <input asp-for="Birthday" class="form-control" type="text" lang="en-US" inputmode="numeric" placeholder="MM/DD/YYYY" autocomplete="bday" value="@birthdayValue" />
                    <small>Use month/day/year.</small>
                    <span asp-validation-for="Birthday"></span>
                </div>
            </div>
        </div>

        <div class="editor-section">
            <p class="eyebrow">Profile photos</p>
            <div class="form-field">
                <label asp-for="Photos">Profile photos</label>
                <div class="file-picker">
                    <input id="profile-photos" type="file" name="Photos" class="file-picker-input" data-status-target="profile-photos-status" aria-describedby="profile-photos-help profile-photos-status" multiple accept=".jpg,.jpeg,.png,.gif" />
                    <label class="file-picker-button" for="profile-photos">Choose files</label>
                    <span id="profile-photos-status" class="file-picker-status">No files selected</span>
                </div>
                <small id="profile-photos-help">Up to 5 JPG, PNG, or GIF images. Maximum 5 MB each.</small>
                <span asp-validation-for="Photos"></span>
            </div>
        </div>

        <div class="editor-actions">
            <a class="button button-quiet" asp-controller="Home" asp-action="Index">Cancel</a>
            <button class="button button-search" type="submit">Save profile <span aria-hidden="true">→</span></button>
        </div>
    </form>

    <aside class="editor-aside">
        <span class="aside-label">Profile editor</span>
        <h2>Make it easy to find your strengths.</h2>
        <p>Keep your profile clear and current. Add your most relevant experience, then connect your skills from the profile page.</p>
        <div class="aside-rule"></div>
        <p class="aside-note">Your account can edit and remove its own profiles.</p>
    </aside>
</div>